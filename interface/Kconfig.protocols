menu "ZBook Interface - Protocols"

config ZBOOK_INTERFACE_PROTOCOLS
	bool "Enable ZBook Interface Protocols"
	default n
	help
	  Enable the ZBook Interface Protocols module.

menu "Zbook I2C Protocol"
	depends on ZBOOK_INTERFACE_PROTOCOLS
	config ZBOOK_INTERFACE_PROTOCOLS_I2C
		bool "ZBook I2C protocol interface"
		select I2C
		default y
		help
			Enable zbook_i2c_init/configure/write/read/write_read, a pure-C
			passthrough over the Zephyr I2C driver bound to the "i2c0"
			devicetree node. Unlike a fixed-address peripheral, this exposes
			the I2C bus itself -- every call takes the target device's 7-bit
			address.

	if ZBOOK_INTERFACE_PROTOCOLS_I2C
		module = ZBOOK_I2C
		module-str = "zbook i2c"
		source "subsys/logging/Kconfig.template.log_config"
	endif # ZBOOK_INTERFACE_PROTOCOLS_I2C
endmenu

endmenu
