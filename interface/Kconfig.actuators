menu "ZBook Interface - Actuators"

config ZBOOK_INTERFACE_ACTUATORS
    bool "Enable ZBook Interface Actuators"
    default n
    help
      Enable the ZBook Interface Actuators module.

    menu "ZBook LED Actuator"
        depends on ZBOOK_INTERFACE_ACTUATORS

        config ZBOOK_INTERFACE_LED
            bool "Enable ZBook LED actuator"
            default y
            help
                Enable the ZBook LED actuator interface.


        config ZBOOK_INTERFACE_LED_BLINK_DEFAULT_MS
            int "Default LED blink duration (ms)"
            default 500
            depends on ZBOOK_INTERFACE_LED
            help
                Set the default blink duration for the ZBook LED actuator in milliseconds.
        
        config ZBOOK_INTERFACE_LED_BLINK_SLOW_MS
            int "Slow LED blink duration (ms)"
            default 1000
            depends on ZBOOK_INTERFACE_LED
            help
                Set the slow blink duration for the ZBook LED actuator in milliseconds.

        config ZBOOK_INTERFACE_LED_BLINK_FAST_MS
            int "Fast LED blink duration (ms)"
            default 250
            depends on ZBOOK_INTERFACE_LED
            help
                Set the fast blink duration for the ZBook LED actuator in milliseconds.
    endmenu
endmenu

if ZBOOK_INTERFACE_LED
    module = LED
    module-str = led
    source "subsys/logging/Kconfig.template.log_config"
endif
