menu "ZBook Interface - Actuators"

config ZBOOK_INTERFACE_ACTUATORS
    bool "Enable ZBook Interface Actuators"
    default n
    help
      Enable the ZBook Interface Actuators module.

    menu "ZBook LED Actuator"
        depends on ZBOOK_INTERFACE_ACTUATORS

        config ZBOOK_INTERFACE_ACTUATORS_LED
            bool "Enable ZBook LED actuator"
            default y
            help
                Enable the ZBook LED actuator interface.


        config ZBOOK_INTERFACE_ACTUATORS_LED_BLINK_DEFAULT_MS
            int "Default LED blink duration (ms)"
            default 500
            depends on ZBOOK_INTERFACE_ACTUATORS_LED
            help
                Set the default blink duration for the ZBook LED actuator in milliseconds.
        
        config ZBOOK_INTERFACE_ACTUATORS_LED_BLINK_SLOW_MS
            int "Slow LED blink duration (ms)"
            default 1000
            depends on ZBOOK_INTERFACE_ACTUATORS_LED
            help
                Set the slow blink duration for the ZBook LED actuator in milliseconds.

        config ZBOOK_INTERFACE_ACTUATORS_LED_BLINK_FAST_MS
            int "Fast LED blink duration (ms)"
            default 250
            depends on ZBOOK_INTERFACE_ACTUATORS_LED
            help
                Set the fast blink duration for the ZBook LED actuator in milliseconds.
    endmenu

    menu "Zbook Buzzer Actuator"
        depends on ZBOOK_INTERFACE_ACTUATORS
    
        config ZBOOK_INTERFACE_ACTUATOR_BUZZER
            bool "Enables ZBook buzzer actuator"
            select PWM
            default y

        config ZBOOK_INTERFACE_ACTUATOR_BUZZER_BEEP_DURATION_SHORT_MS
            int "Short beep duration (ms)"
            default 50
            depends on ZBOOK_INTERFACE_ACTUATOR_BUZZER

        config ZBOOK_INTERFACE_ACTUATOR_BUZZER_BEEP_DURATION_NORMAL_MS
            int "Normal beep duration (ms)"
            default 150
            depends on ZBOOK_INTERFACE_ACTUATOR_BUZZER

        config ZBOOK_INTERFACE_ACTUATOR_BUZZER_BEEP_DURATION_LONG_MS
            int "Long beep duration (ms)"
            default 400
            depends on ZBOOK_INTERFACE_ACTUATOR_BUZZER
    endmenu
endmenu

if ZBOOK_INTERFACE_ACTUATOR_BUZZER
    module = ZBOOK_INTERFACE_ACTUATOR_BUZZER
    module-str = "zbook buzzer"
    source "subsys/logging/Kconfig.template.log_config"
endif

if ZBOOK_INTERFACE_ACTUATORS_LED
    module = LED
    module-str = led
    source "subsys/logging/Kconfig.template.log_config"
endif
