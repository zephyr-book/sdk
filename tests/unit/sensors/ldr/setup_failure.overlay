/*
 * Layered on top of app.overlay for the interface.sensors.ldr.setup_failure
 * scenario. Repoints ldr_adc at ADC_REF_EXTERNAL0, whose reference voltage
 * adc_emul defaults to 0mV (app.overlay only sets ref-internal-mv), so
 * adc_channel_setup() genuinely fails with -ENOTSUP.
 */

&ldr_adc {
	zephyr,reference = "ADC_REF_EXTERNAL0";
};
